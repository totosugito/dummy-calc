<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212">

    <!-- Area HiPER Custom 2D Display (Top) -->
    <com.calctastic.sample.hypercal.display.view.HiPerDisplayContainerView
        android:id="@+id/hiper_display_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.0" />

    <!-- Divider Bar -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#2E2E2E" />

    <!-- Mode bar: DEG / RAD indicator -->
    <LinearLayout
        android:id="@+id/mode_bar"
        android:layout_width="match_parent"
        android:layout_height="26dp"
        android:orientation="horizontal"
        android:gravity="center_vertical|right"
        android:background="#121212">

        <Button
            android:id="@+id/btn_mode_toggle"
            android:text="DEG"
            style="@style/CalcSimpleButton.ModeToggle" />
    </LinearLayout>

    <!-- Keypad CalcTastic Style (Bottom) -->
    <TableLayout
        android:id="@+id/simple_keypad"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2.0"
        android:padding="2dp"
        android:stretchColumns="*">

        <!-- Row 1: Memory row: M+ , M- , MC , MS , MR -->
        <TableRow
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.8">

            <Button
                android:id="@+id/btn_mem_plus"
                android:text="M+"
                style="@style/CalcSimpleButton.Secondary" />
            <Button
                android:id="@+id/btn_mem_minus"
                android:text="M−"
                style="@style/CalcSimpleButton.Secondary" />
            <Button
                android:id="@+id/btn_mem_clear"
                android:text="MC"
                style="@style/CalcSimpleButton.Secondary" />
            <Button
                android:id="@+id/btn_mem_save"
                android:text="MS"
                style="@style/CalcSimpleButton.Secondary" />
            <Button
                android:id="@+id/btn_mem_recall"
                android:text="MR"
                style="@style/CalcSimpleButton.Secondary" />
        </TableRow>

        <!-- Row 2: a/b (fraction) , √x , % , ( , ) -->
        <TableRow
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.85">

            <Button
                android:id="@+id/btn_fraction"
                android:text="a/b"
                style="@style/CalcSimpleButton.Function" />
            <Button
                android:id="@+id/btn_sqrt"
                android:text="√x"
                style="@style/CalcSimpleButton.Function" />
            <Button
                android:id="@+id/btn_percent"
                android:text="%"
                style="@style/CalcSimpleButton.Function" />
            <Button
                android:id="@+id/btn_paren_open"
                android:text="("
                style="@style/CalcSimpleButton.Function" />
            <Button
                android:id="@+id/btn_paren_close"
                android:text=")"
                style="@style/CalcSimpleButton.Function" />
        </TableRow>

        <!-- Row 3: 1/x , x² , xʸ , ◀ , ▶ -->
        <TableRow
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.85">

            <Button
                android:id="@+id/btn_reciprocal"
                android:text="1/x"
                style="@style/CalcSimpleButton.Function" />
            <Button
                android:id="@+id/btn_square"
                android:text="x²"
                style="@style/CalcSimpleButton.Function" />
            <Button
                android:id="@+id/btn_power"
                android:text="xʸ"
                style="@style/CalcSimpleButton.Function" />
            <Button
                android:id="@+id/btn_cursor_left"
                android:text="◀"
                style="@style/CalcSimpleButton.Function" />
            <Button
                android:id="@+id/btn_cursor_right"
                android:text="▶"
                style="@style/CalcSimpleButton.Function" />
        </TableRow>

        <!-- Row 4: 7 , 8 , 9 , DEL , CLR -->
        <TableRow
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.0">

            <Button
                android:id="@+id/btn_7"
                android:text="7"
                style="@style/CalcSimpleButton.Number" />
            <Button
                android:id="@+id/btn_8"
                android:text="8"
                style="@style/CalcSimpleButton.Number" />
            <Button
                android:id="@+id/btn_9"
                android:text="9"
                style="@style/CalcSimpleButton.Number" />
            <Button
                android:id="@+id/btn_delete"
                android:text="DEL"
                style="@style/CalcSimpleButton.Clear" />
            <Button
                android:id="@+id/btn_clear"
                android:text="CLR"
                style="@style/CalcSimpleButton.Clear" />
        </TableRow>

        <!-- Row 5: 4 , 5 , 6 , × , ÷ -->
        <TableRow
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.0">

            <Button
                android:id="@+id/btn_4"
                android:text="4"
                style="@style/CalcSimpleButton.Number" />
            <Button
                android:id="@+id/btn_5"
                android:text="5"
                style="@style/CalcSimpleButton.Number" />
            <Button
                android:id="@+id/btn_6"
                android:text="6"
                style="@style/CalcSimpleButton.Number" />
            <Button
                android:id="@+id/btn_mul"
                android:text="×"
                style="@style/CalcSimpleButton.Operator" />
            <Button
                android:id="@+id/btn_div"
                android:text="÷"
                style="@style/CalcSimpleButton.Operator" />
        </TableRow>

        <!-- Row 6: 1 , 2 , 3 , + , − -->
        <TableRow
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.0">

            <Button
                android:id="@+id/btn_1"
                android:text="1"
                style="@style/CalcSimpleButton.Number" />
            <Button
                android:id="@+id/btn_2"
                android:text="2"
                style="@style/CalcSimpleButton.Number" />
            <Button
                android:id="@+id/btn_3"
                android:text="3"
                style="@style/CalcSimpleButton.Number" />
            <Button
                android:id="@+id/btn_add"
                android:text="+"
                style="@style/CalcSimpleButton.Operator" />
            <Button
                android:id="@+id/btn_sub"
                android:text="−"
                style="@style/CalcSimpleButton.Operator" />
        </TableRow>

        <!-- Row 7: 0 , . , ± , = (2-span) -->
        <TableRow
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.0">

            <Button
                android:id="@+id/btn_0"
                android:text="0"
                style="@style/CalcSimpleButton.Number" />
            <Button
                android:id="@+id/btn_dot"
                android:text="."
                style="@style/CalcSimpleButton.Number" />
            <Button
                android:id="@+id/btn_negate"
                android:text="±"
                style="@style/CalcSimpleButton.Number" />
            <Button
                android:id="@+id/btn_equals"
                android:layout_span="2"
                android:text="="
                style="@style/CalcSimpleButton.Equals" />
        </TableRow>
    </TableLayout>
</LinearLayout>
