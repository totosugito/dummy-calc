<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="#121212">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Calculator Lab"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:fontFamily="@font/font_inter_medium"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Choose a calculator"
        android:textColor="#9E9E9E"
        android:textSize="14sp"
        android:fontFamily="@font/font_inter_medium"
        android:layout_marginBottom="40dp" />

    <Button
        android:id="@+id/btn_calctastic"
        android:text="CalcTastic"
        style="@style/CalcMenuButton" />

    <Button
        android:id="@+id/btn_hypercal"
        android:text="HyperCal"
        style="@style/CalcMenuButton" />
</LinearLayout>
