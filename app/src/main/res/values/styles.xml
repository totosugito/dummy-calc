<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CalcTasticSample" parent="Theme.AppCompat.NoActionBar">
        <item name="android:statusBarColor">#121212</item>
        <item name="android:windowBackground">#121212</item>
        <item name="selectableItemBackground">?android:attr/selectableItemBackground</item>
        <item name="colorControlActivated">#FF9800</item>
        <item name="colorAccent">#FF9800</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="CalcTastic" />

    <style name="CalcTastic.ScreenListViewStyle">
        <item name="android:choiceMode">none</item>
        <item name="android:divider">#3A3A3A</item>
        <item name="android:dividerHeight">0.5dp</item>
        <item name="android:listSelector">@android:color/transparent</item>
        <item name="android:cacheColorHint">@android:color/transparent</item>
        <item name="android:fadingEdge">none</item>
        <item name="android:hapticFeedbackEnabled">false</item>
    </style>

    <style name="CalcTastic.ListItemStyle">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
    </style>

    <style name="CalcTastic.ListItemStyle.Description" parent="CalcTastic.ListItemStyle">
        <item name="android:paddingLeft">5dp</item>
        <item name="android:paddingRight">24dp</item>
        <item name="android:fontFamily">@font/font_roboto_mono_variable</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="CalcTastic.ListItemStyle.Description.Editable" parent="CalcTastic.ListItemStyle.Description">
        <item name="android:paddingRight">0dp</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:fontFamily">@font/font_roboto_mono_variable</item>
        <item name="android:textColor">#EEEEEE</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textCursorDrawable">@drawable/cursor_drawable</item>
        <item name="android:cursorVisible">true</item>
    </style>

    <style name="CalcTastic.ListItemStyle.Value" parent="CalcTastic.ListItemStyle">
        <item name="android:gravity">right|center_vertical</item>
        <item name="android:paddingLeft">32dp</item>
        <item name="android:paddingRight">5dp</item>
        <item name="android:fontFamily">@font/font_roboto_mono_variable</item>
        <item name="android:textColor">#4CAF50</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="CalcTastic.SymbolItemStyle" parent="CalcTastic.ListItemStyle">
        <item name="android:gravity">center</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@font/font_inter_medium</item>
        <item name="android:textColor">#FF9800</item>
    </style>

    <!-- Keypad Button Styles -->
    <style name="CalcSimpleButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_margin">1.5dp</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:focusable">false</item>
        <item name="android:fontFamily">@font/font_inter_medium</item>
    </style>

    <style name="CalcSimpleButton.Number" parent="CalcSimpleButton">
        <item name="android:backgroundTint">#333333</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <style name="CalcSimpleButton.Operator" parent="CalcSimpleButton">
        <item name="android:backgroundTint">#424242</item>
        <item name="android:textColor">#FF9800</item>
    </style>

    <style name="CalcSimpleButton.Function" parent="CalcSimpleButton">
        <item name="android:backgroundTint">#262626</item>
        <item name="android:textColor">#B0BEC5</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="CalcSimpleButton.Secondary" parent="CalcSimpleButton">
        <item name="android:backgroundTint">#212121</item>
        <item name="android:textColor">#9E9E9E</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="CalcSimpleButton.Clear" parent="CalcSimpleButton">
        <item name="android:backgroundTint">#5C2424</item>
        <item name="android:textColor">#FF8A80</item>
    </style>

    <style name="CalcSimpleButton.Equals" parent="CalcSimpleButton">
        <item name="android:backgroundTint">#FF9800</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <style name="CalcSimpleButton.Shift" parent="CalcSimpleButton">
        <item name="android:backgroundTint">#1A237E</item>
        <item name="android:textColor">#8C9EFF</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="CalcSimpleButton.ShiftLabel">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_margin">0dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">#FF9800</item>
        <item name="android:fontFamily">@font/font_inter_medium</item>
        <item name="android:gravity">bottom|center_horizontal</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="CalcSimpleButton.ModeToggle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_marginLeft">4dp</item>
        <item name="android:layout_marginRight">4dp</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">#FF9800</item>
        <item name="android:backgroundTint">#262626</item>
        <item name="android:fontFamily">@font/font_inter_medium</item>
        <item name="android:focusable">false</item>
    </style>
</resources>
